{
  "name": "powui",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "lint": "eslint \"packages/**/*.{js,mjs,ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm test && pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "prettier": "./tooling/prettier/.prettierrc.json"
}
