{
  "name": "@powui/react-native",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@powui/core": "workspace:*",
    "@powui/icons": "workspace:*",
    "@powui/tokens": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.86.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-native": "^0.86.3"
  }
}
