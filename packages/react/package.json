{
  "name": "@powui/react",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@powui/core": "workspace:*",
    "@powui/icons": "workspace:*",
    "@powui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "react": "19.2.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
